{
  "name": "utilities-transcripts",
  "version": "0.1.0",
  "description": "Self-contained, signed HTML transcripts of Discord channels, drawn the way Discord draws them.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./src/index.js",
