    "./viewer.css": "./src/viewer/viewer.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "sample": "node scripts/sample.js",
    "keygen": "node scripts/keygen.js"
  }
}
